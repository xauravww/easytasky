{
  "expo": {
    "name": "EasyTasky",
    "slug": "easytasky",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.smbronze1212.easytasky"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#141414",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#141414"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FA6E1E"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow EasyTasky to use the microphone for voice commands.",
          "speechRecognitionPermission": "Allow EasyTasky to recognize your speech."
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-asset"
    ]
  }
}
